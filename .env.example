# Credenciales de Autenticación de Red (AAA / TACACS+ / Radius)
NET_USER=tu_usuario_tacacs
NET_PASSWORD=tu_password_seguro

# Telemetría y Conectividad LLM
AI_API_KEY=tu_llave_de_google_ai_aqui
# Modelo probado con un evento sintético; disponibilidad y cuotas pueden cambiar.
AI_MODEL=gemini-3.5-flash-lite
# Timeout HTTP por intento, en milisegundos (1000-120000).
AI_TIMEOUT_MS=20000
# Máximo de caracteres después de depurar (256-32000); entradas mayores se rechazan.
AI_MAX_PAYLOAD_CHARS=8000
# Concurrencia máxima y ritmo de inicio de solicitudes, incluidos reintentos.
AI_WORKERS=3
AI_REQUESTS_PER_MINUTE=30
# Circuit breaker por proceso; una sola prueba de recuperación tras la pausa.
AI_FAILURE_THRESHOLD=3
AI_RECOVERY_SECONDS=30
# Solo fallos transitorios; máximo de intentos = 1 + AI_MAX_RETRIES.
AI_MAX_RETRIES=1
AI_RETRY_DELAY_MS=1000
# Presupuesto de espera de admisión, no plazo global de la inferencia.
AI_ADMISSION_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
